{
  "name": "fine-print-decoder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:vercel": "vercel dev --listen 127.0.0.1:3000",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:api": "node scripts/smoke-vercel.mjs",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^26.6.6",
    "@vercel/node": "^29.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vercel": "^65.11.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0"
  },
  "overrides": {
    "tar@^7": "^7.5.22",
    "@fastify/busboy": "^3.2.4"
  }
}
